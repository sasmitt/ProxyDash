# ProxyCheck — environment configuration
# Copy to `.env` and adjust. Every value has a safe default.

# --- Server ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# --- Input / job limits ---
MAX_PROXIES_PER_JOB=25000
MAX_BODY_BYTES=10485760
MAX_JOBS_PER_IP=3
JOB_TTL_MS=7200000

# --- Rate limiting (per client IP) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
JOB_RATE_WINDOW_MS=600000
JOB_RATE_MAX=20

# --- Checking engine ---
DEFAULT_CONCURRENCY=100
MAX_CONCURRENCY=500
MIN_CONCURRENCY=10
DEFAULT_TIMEOUT_MS=8000
DEFAULT_RETRIES=1
HTTPS_TEST=true

# SSRF protection: block proxies that point at private/loopback/reserved
# addresses. Only enable for local development and testing.
ALLOW_PRIVATE_PROXIES=false

# --- Controlled test endpoints (allowlist; do not point at arbitrary URLs) ---
TARGET_ECHO_URLS=http://httpbin.org/get,https://postman-echo.com/get
TARGET_TLS_HOST=cloudflare.com

# --- Geolocation ---
GEO_ENABLED=true
GEO_PROVIDER_URL=http://ip-api.com/batch
GEO_FALLBACK_URL=https://ipwho.is/{ip}
GEO_TTL_MS=21600000
GEO_MAX_REQ_PER_MIN=14
